# Build artifacts
build/
*.dol
*.elf
*.map
*.o
*.d

# Generated assets (regenerated by scripts/setup_assets.sh)
include/embedded_sprites.h
include/embedded_gba_mb.h
data/gba_mb.gba

# Personal save data -- never commit these. Replace with your own.
# (They contain copyrighted Pokémon data and personal trainer info.)
include/embedded_save.h
include/embedded_emerald_save.h
include/embedded_xd_save.h
include/embedded_colo_save.h
data/firered.sav
data/*.sav
data/*.gci
data/*.gcs

# Personal background music -- bring your own WAVs via
# `python3 tools/embed_audio.py {title,match,colosseum} path/to/song.wav`.
include/embedded_title_audio.h
include/embedded_match_audio.h
include/embedded_colosseum_audio.h
data/*.wav

# Vendor reference checkouts (cloned by scripts/setup_assets.sh)
vendor/PKHeX/
vendor/pokeemerald-expansion/
vendor/gba-link-cable-dumper/
vendor/sample_*

# SD card image used for local Dolphin testing
sd.raw

# Native test binaries (rebuild as needed)
tools/test_parse
tools/test_xd
tools/test_colo
tools/test_sha1
tools/gen-test-save/bin/
tools/gen-test-save/obj/

